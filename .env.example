# ÇEŞME MARKET 2 - Dijital Katalog Ortam Değişkenleri (Örnek)
APP_ENV=development
APP_NAME="Çeşme Market 2 - Dijital Katalog"
STORE_ADDRESS=""
STORE_PHONE=""
STORE_WHATSAPP=""
STORE_MAPS_URL=""
SECRET_KEY=cesme_market_2_local_dev_secret_key_change_in_production_2026
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Veritabanı (Yerel geliştirme için SQLite, Production için PostgreSQL)
# PostgreSQL Örneği: postgresql+psycopg2://user:password@localhost:5432/cesme_market_2
DATABASE_URL=sqlite:///./cesme_market2.db

# Varsayılan Yönetim Paneli Başlangıç Hesapları (İlk kurulumda oluşturulur)
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=CesmeAdmin2026!
INITIAL_STAFF_USERNAME=personel
INITIAL_STAFF_PASSWORD=CesmePersonel2026!

# Bildirim Servisleri (İleriki aşama SMS / WhatsApp adaptörleri için)
ENABLE_SMS_NOTIFICATIONS=false
SMS_PROVIDER_API_KEY=
ENABLE_WHATSAPP_NOTIFICATIONS=false
WHATSAPP_API_TOKEN=
